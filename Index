      html += `</table></div>`;

      // --- 機種名のクリーニング処理 ---
      let rawModelName = item["機種名"] || "";
      let cleanName = rawModelName
        .replace(/【[^】]*】/g, "")
        .replace(/au Certified/gi, "")
        .replace(/\(X\)|（X）/gi, "")
        .trim();
      cleanName = cleanName.replace(/\b\d+\s?(GB|TB)\b/gi, "").trim();
      cleanName = cleanName.replace(/\s+/g, " ");

      // iPhone・Pixel以外は型番（英字2〜4桁＋数字2〜3桁等）を自動抽出
      let searchKeywordName = cleanName;
      let isIphoneOrPixel = /iPhone|Pixel/i.test(cleanName);

      if (!isIphoneOrPixel) {
        // 例: SOG18, SCG26, SHG11, OPG04 などのキャリア型番パターンを探す
        let modelMatch = cleanName.match(/\b[A-Za-z]{2,4}\d{2,3}[A-Za-z]?\b/);
        if (modelMatch) {
          searchKeywordName = modelMatch[0];
        }
      }

      // 1. 画像検索URL
      let imageSearchKeyword = encodeURIComponent(cleanName + " カラーバリエーション");
      let googleImageSearchUrl = "https://www.google.com/search?q=" + imageSearchKeyword + "&tbm=isch";

      // 2. スペック検索URL（スマタブinfo）
      let specSearchParam = encodeURIComponent(searchKeywordName);
      let specSearchUrl = "https://smatabinfo.jp/device/search?check-share=&check-info=&shape=0&maker=0&name=" + specSearchParam + "&carrier=0&year_start=0&month_start=0&year_end=0&month_end=0&check-os=&os=0&os_and_os_version=0&check-build=&model_name=&cpu=0&check-display=&display_dpi_horizontal_start=0&display_dpi_horizontal_end=0&display_dpi_vertical_start=0&display_dpi_vertical_end=0&display_size_start=0&display_size_end=0&check-other=&bluetooth_version=0&comm_type=0&search=search";

      // --- 下部のアクションボタン群（スマホ：縦並び、PC：横並び / rel="noreferrer"でリファラー秘匿） ---
      html += '<div class="action-buttons-container">';
      
      // 画像検索ボタン
      html += '<a href="' + googleImageSearchUrl + '" target="_blank" rel="noreferrer noopener" class="action-btn">';
      html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>';
      html += '画像検索（カラバリ）';
      html += '</a>';

      // スペック検索ボタン
      html += '<a href="' + specSearchUrl + '" target="_blank" rel="noreferrer noopener" class="action-btn">';
      html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
      html += 'スペックを検索';
      html += '</a>';

      html += '</div>';

      document.getElementById("modalDetailBody").innerHTML = html;
      detailModalInstance.show();
    }

    function switchPriceMode(mode, btn) {
      const discountArea = document.getElementById("discountPriceArea");
      const koudonArea = document.getElementById("koudonPriceArea");
      const normalArea = document.getElementById("normalPriceArea");
      const titleContainer = document.getElementById("priceSectionTitle");

      const btnDiscount = document.getElementById("btnDiscount");
      const btnKoudon = document.getElementById("btnKoudon");
      const btnNormal = document.getElementById("btnNormal");

      if (discountArea) discountArea.style.display = "none";
      if (koudonArea) koudonArea.style.display = "none";
      if (normalArea) normalArea.style.display = "none";

      if (btnDiscount) btnDiscount.classList.remove("active-mode");
      if (btnKoudon) btnKoudon.classList.remove("active-mode");
      if (btnNormal) btnNormal.classList.remove("active-mode");

      btn.classList.add("active-mode");

      if (mode === 'discount') {
        if (discountArea) discountArea.style.display = "block";
        titleContainer.childNodes[0].nodeValue = "値引割賦充当 ";
      } else if (mode === 'koudon') {
        if (koudonArea) koudonArea.style.display = "block";
        titleContainer.childNodes[0].nodeValue = "値引頭金充当 ";
      } else if (mode === 'normal') {
        if (normalArea) normalArea.style.display = "block";
        titleContainer.childNodes[0].nodeValue = "通常価格 ";
      }
    }
  </script>
</body>
